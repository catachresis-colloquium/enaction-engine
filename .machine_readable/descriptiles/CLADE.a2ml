# SPDX-License-Identifier: MPL-2.0
# Clade declaration — part of the gv-clade-index registry
#
# DEPRECATED (standards CHORA-SPEC 11.1 rule 5). The identity, forges and
# lineage facts below are clauses of enaction-engine_chora.deed, and [status]
# is the (status) clause of STATE.deed, under standards
# 1-formats/deed/mappings/clade-to-repo-deed.adoc. scripts/check-identity.sh
# fails if the two forms differ. This file stays only until every reader of it
# reads the deed; change a fact in both places or the gate refuses it.
#
# See: https://github.com/hyperpolymath/gv-clade-index
#
# Installed by `just init` from build/templates/CLADE.a2ml.in.
# The identity below is DERIVED. The clade is NOT — a human must choose it.

[identity]
# THE ID IS MINTED ONCE, FROM THE BIRTH PATH, AND NEVER MOVES.
# Canon: hyperpolymath/standards 2-protocols/chora/CHORA-SPEC.adoc (rules U1,
# U4, V8, V9, L1, B1, Q2) and gv-clade-index ADR 0008 ("Identity is minted
# once"), which superseded the earlier rule that the id follows the current
# owner. The id is the ADR-008 profile C UUIDv8 of
#
#     <minted-in>:github.com/<birth-path>
#
# (first 16 bytes of SHA-256, version 8, variant 10). This repo was born
# before ruling V9 and was never registered, so under L1 it is registered
# late in the `gv-clade-index` domain. GitHub redirects the birth path
# metadatastician/enaction-engine to the current location, which is the
# evidence for the birth owner. A move changes the location below, never
# the id.
#
# Mint with standards' scripts/uuid-v8.js (gv-clade-index sync/uuid-v8.sh);
# check with scripts/check-identity.sh, which reproduces the spec's known
# answers first. The deed carries this id as an opaque #uuid literal, and the
# birth path appears in no deed (U4).
#
# The earlier values were UUIDv5s of a path (the 2026-11-09 Q7 ruling
# targeted one of the current path). U1, V8 and Q2 retired that form; they are
# kept only as history in docs/proposals/ULTRACODE-COMPLETION-PLAN.adoc,
# shortened to 8 hex digits.
#
# REGISTRATION IS STILL THE OWNER'S ACT (see the end of this file).
uuid = "aa4cefc5-1955-8821-ab3f-cdae5c79fd69"
minted-in = "gv-clade-index"
birth-path = "metadatastician/enaction-engine"
beholding-estate = "1642c392-8eac-8e3f-b762-2898b9344228"
primary-forge = "github"
primary-owner = "catachresis-colloquium"
canonical-name = "enaction-engine"
prefixed-name = "gm-enaction-engine"

[clade]
# ---------------------------------------------------------------------------
# CHOOSE ONE. A CLOSED TAXONOMY OF 12 CATEGORIES — NOT AN ABBREVIATION SCHEME.
#
# The two letters abbreviate the NAME OF THE CLADE. They NEVER abbreviate the
# name of your repo. Pick the category your repo belongs to, then write down
# that category's code. Do NOT look at your repo's name and hunt for two letters
# that fit it.
#
#   fv  Formal Verification & Proofs   provable correctness, dependent types, theorem proving
#   nl  Nextgen Languages              compilers, runtimes, language tooling
#   rm  Repo Management & Tooling      scaffolding, graph analysis, bots, templates
#   gv  Governance & Standards         licensing, compliance, policy enforcement
#   db  Databases                      database engines, query languages, storage
#   ap  Applications                   end-user apps, web, desktop, services
#   ix  Infrastructure & Cloud         containers, deployment, sysadmin
#   dx  Developer Ecosystem            dev tools, package managers, editors, bindings
#   pt  Protocols & Interop            internet standards, protocol implementations
#   ax  AI & Neurosymbolic             ML, neural proof synthesis, AI governance
#   gm  Games & Interactive            game engines, interactive experiences
#   sc  Security                       scanning, vulnerability management, access control
#
# This is spelled out because the opposite was done, more than once:
#
#   paint-type  chose `pt`, reading it as "PainT-type".
#               `pt` is Protocols & Interop. An image editor is `ap`.
#   gossamer    chose `gv`, reading it as "Graphical/Visual".
#               `gv` is GoVernance & Standards. There is no graphical clade.
#
# Both codes were VALID, so every check passed, and both repos sat filed under a
# category they have nothing to do with.
#
# HOW TO CHOOSE (spec): "The primary clade reflects the project's core value
# proposition, not its implementation details." Ask what the repo is FOR, not
# what it is built with. A game written in Idris2 is `gm`, not `fv`. A webview
# shell with formal ABI proofs is what developers build on, not a proof project.
#
# Fill in BOTH `primary` and `primary-name`, and make them agree — CLADE-006
# rejects a mismatched pair. The redundancy is deliberate: a code alone cannot
# express a wrong belief about what it means, so it cannot be checked for one.
# The pair can.
#
# Until you fill these in, CLADE-003 and CLADE-006 FAIL. That is deliberate: an
# unchosen clade must never be mistakable for a chosen one. Leaving a valid-
# looking default here is exactly how every repo built from this template ended
# up silently claiming "rm".
# ---------------------------------------------------------------------------
primary = "gm"
primary-name = "Games & Interactive"
secondary = []
assigned = "2026-07-25"
rationale = "The core value proposition is a complete game engine for interactive worlds; Rust and deterministic simulation are implementation properties, not its clade."

[forges]
github = "catachresis-colloquium/enaction-engine"
gitlab = ""       # populated if/when mirrored
bitbucket = ""    # populated if/when mirrored

[lineage]
type = "standalone"           # standalone | monorepo | monorepo-child | inflated | deflated
parent = ""                   # a monorepo PARENT — never a description of this repo
born = "2026-07-22"
previous-names = []
instantiated-from = "rsr-template-repo"

[status]
# One of: reserved incubating active dormant | merged superseded archived extinct
phase = "incubating"          # a repo created today has not proven anything yet
since = "2026-07-22"
present = true
aliases = []
merged-into = ""
superseded-by = ""
successors = []
ended = ""

[[status.history]]
phase = "incubating"
since = "2026-07-22"
note = "created from rsr-template-repo as a game-engine project; registration remains an owner action"

# ---------------------------------------------------------------------------
# REGISTRATION IS NOT DERIVATION. Deriving the uuid above does not register this
# repo. Registration means an entry in gv-clade-index verisim/seed/repos.a2ml,
# it is outward-facing, and it is the OWNER's act — an agent must not do it.
# ---------------------------------------------------------------------------
